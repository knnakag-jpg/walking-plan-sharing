  function haversine(a,b){
    var R=6371000, toRad=function(d){return d*Math.PI/180;};
    var dLat=toRad(b[0]-a[0]), dLon=toRad(b[1]-a[1]);
    var lat1=toRad(a[0]), lat2=toRad(b[0]);
    var h=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1)*Math.cos(lat2)*Math.sin(dLon/2)*Math.sin(dLon/2);
    return 2*R*Math.asin(Math.sqrt(h));
  }
  function straightLength(pts){
    var s=0; for(var i=1;i<pts.length;i++) s+= haversine(pts[i-1], pts[i]); return s;
  }

  // Decodes a Valhalla/Google-algorithm encoded polyline (precision 6).
  function decodePolyline6(str){
    var index=0, lat=0, lng=0, coords=[];
    while(index<str.length){
      var result=1, shift=0, b;
      do{ b=str.charCodeAt(index++)-63-1; result+=b<<shift; shift+=5; }while(b>=0x1f);
      lat += (result&1) ? ~(result>>1) : (result>>1);
      result=1; shift=0;
      do{ b=str.charCodeAt(index++)-63-1; result+=b<<shift; shift+=5; }while(b>=0x1f);
      lng += (result&1) ? ~(result>>1) : (result>>1);
      coords.push([lat/1e6, lng/1e6]);
    }
    return coords;
  }

  function nearestOnLine(p, latlngs){
    var best=null, bd=Infinity;
    for(var i=0;i<latlngs.length;i++){
      var d = haversine(p, latlngs[i]);
      if(d<bd){ bd=d; best=latlngs[i]; }
    }
    return best;
  }

  // Draws the pre-computed pedestrian-routed line for a course from the embedded ROUTE_GEOM
  // table. Returns the routed latlngs, or null if no embedded geometry exists — in that case
  // NOTHING is drawn (this renderer never falls back to a straight line through buildings/water).
  function drawEmbeddedRoute(layerGroup, course, color){
    var g = (typeof ROUTE_GEOM !== 'undefined') ? ROUTE_GEOM[course.n] : null;
    if(!g) return null;
    var latlngs = decodePolyline6(g.shape);
    L.polyline(latlngs, { color:'#fff', weight:8, opacity:0.25 }).addTo(layerGroup);
    L.polyline(latlngs, { color:color, weight:5, opacity:0.92 }).addTo(layerGroup);
    return latlngs;
  }

  function drawMarkers(layerGroup, course, color, routedLatLngs){
    var pts = course.r;
    pts.forEach(function (p, i) {
      var mp = routedLatLngs ? nearestOnLine(p, routedLatLngs) : p;
      var isStart = (i === 0);
      var isGoal = (i === pts.length - 1);
      var fill = isStart ? '#2563eb' : (isGoal ? '#e11d48' : '#64748b');
      var radius = (isStart || isGoal) ? 7 : 5;
      var kind = isStart ? '起点（Start）' : (isGoal ? 'ゴール（Goal）' : '経由点 ' + i);
      var m = L.circleMarker(mp, { radius: radius, color: '#fff', weight: 2, fillColor: fill, fillOpacity: 1 });
      var popup = '<b>' + course.n + ' ' + course.name + '</b><br>' + kind;
      if(!isStart && !isGoal){
        m.bindTooltip(String(i), {permanent:false, direction:'top', offset:[0,-6]});
      }
      m.bindPopup(popup);
      m.addTo(layerGroup);
      if(!isStart && !isGoal){
        var lbl = L.divIcon({className:'', html:'<div style="background:'+color+';color:#fff;font-size:9px;font-weight:700;border-radius:50%;width:16px;height:16px;line-height:16px;text-align:center;border:1px solid #fff;box-shadow:0 1px 3px rgba(0,0,0,.3)">'+i+'</div>', iconSize:[16,16], iconAnchor:[8,8]});
        L.marker(mp, {icon: lbl, interactive:false}).addTo(layerGroup);
      }
    });
  }

  // Runtime "recompute" — fetches a fresh Valhalla pedestrian route for the course and swaps it
  // in. On failure (offline, rate limit, etc.) the embedded line is left untouched.
  function recomputeRouteLive(course, color, layerGroup, mapObj, statusEl){
    var reqId = ++liveRecomputeReqId;
    if(statusEl) statusEl.textContent = '再計算中…';
    var body = { locations: course.r.map(function(p){ return {lat:p[0], lon:p[1]}; }), costing:'pedestrian', units:'kilometers' };
    fetch('https://valhalla1.openstreetmap.de/route', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) })
      .then(function(res){ if(!res.ok) throw new Error('HTTP '+res.status); return res.json(); })
      .then(function(data){
        if(reqId !== liveRecomputeReqId) return;
        if(!data.trip || !data.trip.legs || !data.trip.legs.length) throw new Error('経路が見つかりませんでした');
        var full = [];
        data.trip.legs.forEach(function(leg, i){
          var seg = decodePolyline6(leg.shape);
          full = full.concat(i===0 ? seg : seg.slice(1));
        });
        layerGroup.clearLayers();
        L.polyline(full, { color:'#fff', weight:8, opacity:0.25 }).addTo(layerGroup);
        L.polyline(full, { color:color, weight:5, opacity:0.92 }).addTo(layerGroup);
        drawMarkers(layerGroup, course, color, full);
        try{ mapObj.fitBounds(L.latLngBounds(full).pad(0.20)); }catch(e){}
        if(statusEl) statusEl.textContent = '再計算完了（実測 約' + data.trip.summary.length.toFixed(2) + 'km・Valhalla歩行者ルート）';
      })
      .catch(function(err){
        if(reqId !== liveRecomputeReqId) return;
        if(statusEl) statusEl.textContent = '⚠ 再計算に失敗しました（埋め込み済みルートを表示中）：' + err.message;
      });
  }

  // Thins an ordered point list down to at most maxIntermediate interior points, always
  // keeping the first and last point. Used only for Google Maps nav URLs, which cap
  // `waypoints` at 9 intermediate points — course.r itself is left untouched.
  function thinWaypoints(pts, maxIntermediate){
    if(pts.length <= maxIntermediate + 2) return pts;
    var mid = pts.slice(1, pts.length - 1);
    var keep = [];
    for(var i=0;i<maxIntermediate;i++){
      var idx = Math.round(i * (mid.length - 1) / (maxIntermediate - 1));
      keep.push(mid[idx]);
    }
    var seen = {}, dedup = [];
    keep.forEach(function(p){ var k=p[0]+','+p[1]; if(!seen[k]){ seen[k]=1; dedup.push(p); } });
    return [pts[0]].concat(dedup, [pts[pts.length-1]]);
  }

  // Builds a Google Maps walking-navigation URL from the course's meaningful waypoints
  // (course.r — the same anchors drawn as numbered markers), NOT the dense routed polyline.
  // Google re-routes and re-measures this independently, so the distance it shows will not
  // match ROUTE_GEOM[n].km — that divergence is expected (see updateGmapNote / Handover.md).
  function buildGoogleNavUrl(course){
    var pts = thinWaypoints(course.r, 9);
    var fmt = function(p){ return p[0].toFixed(6) + ',' + p[1].toFixed(6); };
    var url = 'https://www.google.com/maps/dir/?api=1&origin=' + fmt(pts[0]) + '&destination=' + fmt(pts[pts.length - 1]);
    var mid = pts.slice(1, pts.length - 1);
    if(mid.length) url += '&waypoints=' + encodeURIComponent(mid.map(fmt).join('|'));
    url += '&travelmode=walking';
    return url;
  }

  function findCourseByNum(num){
    var key = /^[0-9]/.test(num) ? ('No.' + num) : num;
    for(var si=0; si<SERIES.length; si++){
      var courses = SERIES[si].courses;
      for(var ci=0; ci<courses.length; ci++){
        if(courses[ci].n === key) return courses[ci];
      }
    }
    return null;
  }

  function legacyCopy(text){
    try{
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      var success = document.execCommand('copy');
      document.body.removeChild(ta);
      return success;
    }catch(e){ return false; }
  }

  function copyToClipboard(text, statusEl){
    function ok(){ if(statusEl){ statusEl.textContent = 'コピーしました'; setTimeout(function(){ statusEl.textContent = ''; }, 2500); } }
    function fail(){ if(statusEl) statusEl.textContent = '⚠ コピーに失敗しました'; }
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(ok, function(){ legacyCopy(text) ? ok() : fail(); });
    } else {
      legacyCopy(text) ? ok() : fail();
    }
  }

  // Discloses that the Google nav link is a hand-off to an external, independently-routed
  // navigation tool — never "fix" the coordinates or ROUTE_GEOM[n].km to make this note's
  // divergence go away; see Handover.md.
  function updateGmapNote(course, noteEl){
    if(!noteEl) return;
    var g = (typeof ROUTE_GEOM !== 'undefined') ? ROUTE_GEOM[course.n] : null;
    noteEl.textContent = g && g.km
      ? '※ Googleが独自に徒歩ルートを再計算するため、表示距離は本資料の実測値（約' + g.km.toFixed(1) + 'km）と数%前後します。'
      : '※ Googleが独自に徒歩ルートを再計算するため、表示距離は本資料の記載距離と数%前後します。';
  }

  function renderCourse() {
    if (!map) return;
    if (!routeLayer) routeLayer = L.layerGroup().addTo(map);
    routeLayer.clearLayers();
    liveRecomputeReqId++; // invalidate any in-flight recompute for the previous course

    var course = SERIES[currentSeries].courses[currentCourse];
    var color = SERIES[currentSeries].color;
    var latlngs = drawEmbeddedRoute(routeLayer, course, color);
    drawMarkers(routeLayer, course, color, latlngs);

    var statusEl = document.getElementById('map-recompute-status');
    if (statusEl) statusEl.textContent = latlngs ? '' : '⚠ 経路データ未生成（実行時再計算をお試しください）';
    updateGmapNote(course, document.getElementById('gmap-note'));

    try{
      if (latlngs) map.fitBounds(L.latLngBounds(latlngs).pad(0.20));
      else map.fitBounds(L.latLngBounds(course.r).pad(0.28));
    }catch(e){}
    renderDetail(course);
  }

  function findCard(course) {
    var cards = document.querySelectorAll('.card');
    for (var i = 0; i < cards.length; i++) {
      var h = cards[i].querySelector('h3');
      if (h && h.textContent.indexOf(course.n + '｜') === 0) return cards[i];
    }
    return null;
  }

  function enhanceCourses(){
    document.querySelectorAll('.card').forEach(function(card){
      var h = card.querySelector('h3[id^="course-"]');
      if(!h || card.querySelector('.course-map-jump')) return;
      var num = h.id.replace('course-','');
      var btn = document.createElement('button');
      btn.className = 'course-map-jump';
      var isSolo = !!card.closest('#panel-solo');
      if(isSolo){
        btn.textContent = '\uD83D\uDDFA \u3053\u306e\u30b3\u30fc\u30b9\u3092\u4fee\u884c\u30de\u30c3\u30d7\u3067\u898b\u308b \u2192';
        btn.onclick = function(){ jumpToMapSolo(num); };
      } else {
        btn.textContent = '\U0001f5fa \u3053\u306e\u30b3\u30fc\u30b9\u3092\u5730\u56f3\u3067\u898b\u308b \u2192';
        btn.onclick = function(){ jumpToMap(num); };
      }
      var route = card.querySelector('.route');
      if(route) route.parentNode.insertBefore(btn, route);
      else card.appendChild(btn);

      var course = findCourseByNum(num);
      if(course){
        var gbtn = document.createElement('button');
        gbtn.type = 'button';
        gbtn.className = 'course-map-jump gmap-nav-btn';
        gbtn.textContent = '📍 Googleマップの徒歩ナビで開く';
        gbtn.onclick = function(){ window.open(buildGoogleNavUrl(course), '_blank', 'noopener'); };
        if(route) route.parentNode.insertBefore(gbtn, route);
        else card.appendChild(gbtn);
      }
    });
  }
  function getSoloSeriesIndex(){
    for(var i=0;i<SERIES.length;i++) if(SERIES[i].id==='solo') return i;
    return -1;
  }
  function getSoloSeriesList(){
    var list=[];
    for(var i=0;i<SERIES.length;i++) if(SERIES[i].id==='solo' || SERIES[i].id==='enso' || SERIES[i].id==='zenkoku') list.push({idx:i, s:SERIES[i]});
    return list;
  }
  function buildButtonsSolo(){
    var sc = document.getElementById('series-controls-solo');
    var cc = document.getElementById('course-controls-solo');
    if(!sc||!cc) return;
    sc.innerHTML=''; cc.innerHTML='';
    var list = getSoloSeriesList();
    if(!list.length) return;
    // clamp currentSeriesSolo to valid index in list
    if(currentSeriesSolo<0 || currentSeriesSolo>=list.length) currentSeriesSolo=0;
    list.forEach(function(item, li){
      var b = document.createElement('button');
      b.type='button';
      b.className='map-btn' + (li===currentSeriesSolo ? ' series-on' : '');
      b.textContent=item.s.name;
      b.onclick=function(){ currentSeriesSolo=li; currentCourseSolo=0; buildButtonsSolo(); renderCourseSolo(); };
      sc.appendChild(b);
    });
    var cur = list[currentSeriesSolo].s;
    cur.courses.forEach(function(c, ci){
      var btn=document.createElement('button');
      btn.type='button';
      btn.className='map-btn' + (ci===currentCourseSolo ? ' on' : '');
      btn.textContent=c.n+' '+c.name;
      btn.onclick=function(){ currentCourseSolo=ci; buildButtonsSolo(); renderCourseSolo(); };
      cc.appendChild(btn);
    });
  }
  function findCardSolo(course){
    var cards = document.querySelectorAll('#panel-solo .card');
    for(var i=0;i<cards.length;i++){
      var h=cards[i].querySelector('h3');
      if(h && h.textContent.indexOf(course.n+'\uff5c')===0) return cards[i];
    }
    return null;
  }
  function renderDetailSolo(course){
    var el=document.getElementById('map-detail-solo');
    if(!el) return;
    var card=findCardSolo(course);
    if(!card){
      el.innerHTML='<div class="map-detail-empty">\u3053\u306e\u30b3\u30fc\u30b9\u306e\u8a73\u7d30\u30ab\u30fc\u30c9\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002</div>';
      return;
    }
    var clone=card.cloneNode(true);
    var num=course.n.replace('S','');
    var jumpBack=document.createElement('p');jumpBack.style.margin='10px 0';var backBtn=document.createElement('button');backBtn.className='course-map-jump';backBtn.textContent='\u4fee\u884c\u6848\u3067\u65c5\u7a0b\u8a73\u7d30\u3092\u898b\u308b\uff08S'+num+'\uff09';backBtn.onclick=function(){ var target=document.getElementById('course-S'+num); if(target) target.scrollIntoView({behavior:'smooth',block:'start'}); };jumpBack.appendChild(backBtn);
    el.innerHTML='<div class="map-detail-label">\u9078\u629e\u4e2d\u30b3\u30fc\u30b9\u306e\u65c5\u7a0b\u8a73\u7d30</div>' + clone.innerHTML;
    el.appendChild(jumpBack);
  }
  function renderCourseSolo(){
    if(!mapSolo) return;
    if(!routeLayerSolo) routeLayerSolo=L.layerGroup().addTo(mapSolo);
    routeLayerSolo.clearLayers();
    liveRecomputeReqId++; // invalidate any in-flight recompute for the previous course
    var list=getSoloSeriesList();
    if(!list.length) return;
    if(currentSeriesSolo<0||currentSeriesSolo>=list.length) currentSeriesSolo=0;
    var soloIdx=list[currentSeriesSolo].idx;
    var course=SERIES[soloIdx].courses[currentCourseSolo];
    var color=SERIES[soloIdx].color;
    var latlngs = drawEmbeddedRoute(routeLayerSolo, course, color);
    drawMarkers(routeLayerSolo, course, color, latlngs);

    var statusEl = document.getElementById('map-recompute-status-solo');
    if (statusEl) statusEl.textContent = latlngs ? '' : '\u26a0 \u7d4c\u8def\u30c7\u30fc\u30bf\u672a\u751f\u6210\uff08\u5b9f\u884c\u6642\u518d\u8a08\u7b97\u3092\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\uff09';
    updateGmapNote(course, document.getElementById('gmap-note-solo'));

    try{
      if (latlngs) mapSolo.fitBounds(L.latLngBounds(latlngs).pad(0.20));
      else mapSolo.fitBounds(L.latLngBounds(course.r).pad(0.28));
    }catch(e){}
    renderDetailSolo(course);
  }
  function jumpToMapSolo(courseNum){
    switchTab('solo');
    var target=String(courseNum);
    var list=getSoloSeriesList();
    for(var li=0; li<list.length; li++){
      var courses=list[li].s.courses;
      for(var ci=0;ci<courses.length;ci++){
        if(courses[ci].n===target || courses[ci].n.replace('No.','')===target || courses[ci].n.replace('S','')===String(courseNum).replace('S','')){
          currentSeriesSolo=li;
          currentCourseSolo=ci;
          setTimeout(function(){ buildButtonsSolo(); renderCourseSolo(); if(mapSolo) mapSolo.invalidateSize(); var el=document.getElementById('map-solo'); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }, 220);
          return;
        }
      }
    }
    setTimeout(function(){ if(mapSolo) mapSolo.invalidateSize(); var el=document.getElementById('map-solo'); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); }, 220);
  }
  function renderDetail(course) {
    var el = document.getElementById('map-detail');
    if (!el) return;
    var card = findCard(course);
    if (!card) {
      el.innerHTML = '<div class="map-detail-empty">このコースの詳細カードが見つかりませんでした。</div>';
      return;
    }
    var clone = card.cloneNode(true);
    var num = course.n.replace('No.','');
    var jumpBack=document.createElement('p');jumpBack.style.margin='10px 0';var backBtn=document.createElement('button');backBtn.className='course-map-jump';backBtn.textContent='\u30DB\u30FC\u30E0\u3067\u65C5\u7A0B\u8A73\u7D30\u3092\u898B\u308B\uFF08No.'+num+'\uFF09';backBtn.onclick=function(){switchTab('home');setTimeout(function(){var target=document.getElementById('course-'+num);if(target)target.scrollIntoView({behavior:'smooth',block:'start'});},220);};jumpBack.appendChild(backBtn)
    el.innerHTML = '<div class="map-detail-label">選択中コースの旅程詳細</div>' + clone.innerHTML;
    el.appendChild(jumpBack);
  }


  function escapeHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function buildNav() {
    var nav = document.getElementById('map-nav');
    if (!nav) return;

    var chapLinks = '';
    var hs = document.querySelectorAll('h2[id^="sec-"]');
    for (var i = 0; i < hs.length; i++) {
      chapLinks += '<a class="map-nav-link" href="#' + hs[i].id + '">' + escapeHtml(hs[i].textContent) + '</a>';
    }

    var courseLinks = '';
    SERIES.forEach(function (s) {
      courseLinks += '<div class="map-nav-group">' + escapeHtml(s.name) + '</div>';
      s.courses.forEach(function (c) {
        var num = c.n.replace('No.', '');
        courseLinks += '<a class="map-nav-link" href="#course-' + num + '">' + escapeHtml(c.n + ' ' + c.name) + '</a>';
      });
    });

    nav.innerHTML =
      '<a class="map-nav-top" href="#top">↑ 本文トップへ</a>' +
      '<details class="map-nav-details" open>' +
        '<summary>本文の各章へジャンプ（第1〜18章）</summary>' +
        '<div class="map-nav-links">' + chapLinks + '</div>' +
      '</details>' +
      '<details class="map-nav-details">' +
        '<summary>各コースカードへジャンプ（No.1〜55）</summary>' +
        '<div class="map-nav-links">' + courseLinks + '</div>' +
      '</details>';
  }

  function switchTab(id){
    document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.toggle('active', b.dataset.tab===id); b.setAttribute('aria-selected', b.dataset.tab===id ? 'true':'false'); });
    document.querySelectorAll('.tab-panel').forEach(function(p){ p.classList.toggle('active', p.id==='panel-'+id); });
    if(id==='map'){ setTimeout(function(){ if(map) map.invalidateSize(); }, 180); }
    if(id==='solo'){ setTimeout(function(){ if(mapSolo) mapSolo.invalidateSize(); }, 180); }
    // update hash for share
    try{ history.replaceState(null,'','#tab='+id); }catch(e){}
    window.scrollTo({top:0, behavior:'smooth'});
  }
  function jumpToMap(courseNum){
    switchTab('map');
    // find course index
    var target = String(courseNum);
    // SERIES is array of series; linear search
    for(var si=0; si<SERIES.length; si++){
      for(var ci=0; ci<SERIES[si].courses.length; ci++){
        var n = SERIES[si].courses[ci].n.replace('No.','');
        if(n===target){
          currentSeries = si;
          currentCourse = ci;
          // need to re-render after tab visible
          setTimeout(function(){ buildButtons(); renderCourse(); if(map) map.invalidateSize(); }, 220);
          return;
        }
      }
    }
  }
  function init() {
    // restore tab from hash
    var m = location.hash.match(/tab=(home|map|solo|history)/);
    if(m){ 
      // defer to let DOM ready
      setTimeout(function(){ switchTab(m[1]); }, 0);
    }
    map = L.map('map', { zoomControl: true });
    map.setView([35.68, 139.75], 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    buildButtons();
    renderCourse();
    buildNav();
    enhanceCourses();
    if(document.getElementById('map-solo')){
      mapSolo=L.map('map-solo',{zoomControl:true});
      mapSolo.setView([35.68,139.75],10);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(mapSolo);
      buildButtonsSolo();
      renderCourseSolo();
    }
    var recomputeBtn = document.getElementById('map-recompute-btn');
    if(recomputeBtn) recomputeBtn.onclick = function(){
      var course = SERIES[currentSeries].courses[currentCourse];
      var color = SERIES[currentSeries].color;
      recomputeRouteLive(course, color, routeLayer, map, document.getElementById('map-recompute-status'));
    };
    var recomputeBtnSolo = document.getElementById('map-recompute-btn-solo');
    if(recomputeBtnSolo) recomputeBtnSolo.onclick = function(){
      var list = getSoloSeriesList();
      if(!list.length) return;
      var soloIdx = list[currentSeriesSolo].idx;
      var course = SERIES[soloIdx].courses[currentCourseSolo];
      var color = SERIES[soloIdx].color;
      recomputeRouteLive(course, color, routeLayerSolo, mapSolo, document.getElementById('map-recompute-status-solo'));
    };
    var gmapOpenBtn = document.getElementById('gmap-open-btn');
    if(gmapOpenBtn) gmapOpenBtn.onclick = function(){
      var course = SERIES[currentSeries].courses[currentCourse];
      window.open(buildGoogleNavUrl(course), '_blank', 'noopener');
    };
    var gmapCopyBtn = document.getElementById('gmap-copy-btn');
    if(gmapCopyBtn) gmapCopyBtn.onclick = function(){
      var course = SERIES[currentSeries].courses[currentCourse];
      copyToClipboard(buildGoogleNavUrl(course), document.getElementById('gmap-status'));
    };
    var gmapOpenBtnSolo = document.getElementById('gmap-open-btn-solo');
    if(gmapOpenBtnSolo) gmapOpenBtnSolo.onclick = function(){
      var list = getSoloSeriesList();
      if(!list.length) return;
      var soloIdx = list[currentSeriesSolo].idx;
      var course = SERIES[soloIdx].courses[currentCourseSolo];
      window.open(buildGoogleNavUrl(course), '_blank', 'noopener');
    };
    var gmapCopyBtnSolo = document.getElementById('gmap-copy-btn-solo');
    if(gmapCopyBtnSolo) gmapCopyBtnSolo.onclick = function(){
      var list = getSoloSeriesList();
      if(!list.length) return;
      var soloIdx = list[currentSeriesSolo].idx;
      var course = SERIES[soloIdx].courses[currentCourseSolo];
      copyToClipboard(buildGoogleNavUrl(course), document.getElementById('gmap-status-solo'));
    };
    window.switchTab = switchTab;
    window.jumpToMap = jumpToMap;
    // クロスタブのアンカー（#sec-* / #course-* はホームへ切替後にスクロール）
    document.addEventListener('click', function(e){
      var a = e.target.closest('a[href^="#"]');
      if(!a) return;
      var href = a.getAttribute('href');
      if(!href || href==="#" || href==="#top") return;
      if(href.indexOf('#sec-')===0 || href.indexOf('#course-')===0){
        var targetId = href.slice(1);
        var target = document.getElementById(targetId);
        if(target){
          var panel = target.closest('.tab-panel');
          // すでにホームに含まれている想定だが、タブが違えば切替
          if(panel && !panel.classList.contains('active')){
            e.preventDefault();
            var tabId = panel.id.replace('panel-','');
            switchTab(tabId);
            setTimeout(function(){
              var t2 = document.getElementById(targetId);
              if(t2) t2.scrollIntoView({behavior:'smooth', block:'start'});
            }, 240);
          } else if(!panel){
            // map-nav等からホームへの遷移とみなす
            e.preventDefault();
            switchTab('home');
            setTimeout(function(){
              var t2 = document.getElementById(targetId);
              if(t2) t2.scrollIntoView({behavior:'smooth', block:'start'});
            }, 240);
          }
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
