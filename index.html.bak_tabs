        { n:'No.39', name:'荒川 千住大土手・スカイツリー', c:[35.7500,139.8150], r:[[35.74900,139.80480],[35.75380,139.80380],[35.74900,139.80800],[35.74280,139.81480],[35.74750,139.82700],[35.74600,139.83200]] },
        { n:'No.40', name:'荒川 赤水門・岩淵', c:[35.7920,139.7260], r:[[35.78600,139.72000],[35.78720,139.72850],[35.78900,139.73000],[35.79500,139.72600],[35.80100,139.72000]] },
        { n:'No.41', name:'江戸川 矢切の渡し・柴又', c:[35.7650,139.8780], r:[[35.76920,139.87050],[35.77280,139.87900],[35.76280,139.88120],[35.76100,139.88250],[35.75880,139.87820],[35.75700,139.87350],[35.75300,139.87000],[35.74950,139.86500]] }
      ]
    },
    {
      id: 'bayarea', name: 'ベイエリア橋（No.42～45）', color: '#e11d48',
      courses: [
        { n:'No.42', name:'横浜 女神橋・大さん橋', c:[35.4520,139.6410], r:[[35.43850,139.64250],[35.44300,139.64500],[35.45220,139.64750],[35.45820,139.63850],[35.46100,139.63600],[35.45950,139.63000],[35.45780,139.63280]] },
        { n:'No.43', name:'東京 夢の大橋・豊洲', c:[35.6380,139.7860], r:[[35.62650,139.77880],[35.62980,139.78450],[35.64200,139.78200],[35.64550,139.78050],[35.65500,139.79600]] },
        { n:'No.44', name:'川崎・羽田 多摩川スカイブリッジ', c:[35.5390,139.7600], r:[[35.53320,139.74680],[35.53980,139.76850],[35.54600,139.76800],[35.54480,139.76880],[35.54450,139.76950]] },
        { n:'No.45', name:'木更津 中の島大橋', c:[35.3815,139.9150], r:[[35.38150,139.92700],[35.38120,139.91400],[35.38180,139.90900],[35.38150,139.90400],[35.38000,139.92000],[35.38150,139.92700]] }
      ]
    },
    {
      id: 'v4bay', name: 'V4湾岸追加（No.46）', color: '#0ea5e9',
      courses: [
        { n:'No.46', name:'夢の島熱帯植物館〜葛西臨海水族園', c:[35.6435,139.8450], r:[[35.64320,139.83000],[35.64650,139.83200],[35.64500,139.83350],[35.64200,139.84000],[35.64050,139.83800],[35.64200,139.85000],[35.64250,139.85500],[35.64000,139.86000],[35.64450,139.86000]] }
      ]
    },
    {
      id: 'v4bc', name: 'V4-B/Cグルメ（No.47〜52）', color: '#d97706',
      courses: [
        { n:'No.47', name:'清澄白河〜両国・錦糸町', c:[35.6880,139.8000], r:[[35.68050,139.79900],[35.68100,139.79750],[35.68300,139.80400],[35.67950,139.80300],[35.69600,139.79350],[35.69950,139.79250],[35.69650,139.81400]] },
        { n:'No.48', name:'両国〜浅草〜スカイツリー', c:[35.7070,139.8020], r:[[35.69600,139.79350],[35.69800,139.79600],[35.70850,139.80000],[35.71450,139.79650],[35.71300,139.80400],[35.71000,139.81000],[35.71010,139.81080]] },
        { n:'No.49', name:'吉祥寺〜井の頭〜三鷹', c:[35.7000,139.5730], r:[[35.70300,139.58050],[35.70150,139.57800],[35.69950,139.57600],[35.69600,139.57050],[35.69450,139.56800],[35.70250,139.56050]] },
        { n:'No.50', name:'谷根千 坂と行列グルメ', c:[35.7180,139.7700], r:[[35.70750,139.77400],[35.70700,139.76750],[35.72050,139.76550],[35.72400,139.76500],[35.72750,139.76950],[35.72350,139.77100],[35.72800,139.77150]] },
        { n:'No.51', name:'中目黒〜代官山〜恵比寿', c:[35.6460,139.7050], r:[[35.64400,139.69950],[35.64350,139.69800],[35.64850,139.70050],[35.64900,139.70300],[35.64250,139.71000],[35.64650,139.71050]] },
        { n:'No.52', name:'神楽坂 石畳坂と路地グルメ', c:[35.7035,139.7370], r:[[35.70200,139.74400],[35.70350,139.74100],[35.70400,139.73950],[35.70300,139.73800],[35.70250,139.73000],[35.70550,139.72200],[35.70600,139.72200]] }
      ]
    },
    {
      id: 'v4haru', name: 'V4春限定（No.53〜55）', color: '#e11d48',
      courses: [
        { n:'No.53', name:'京王百草園 梅林早春', c:[35.6560,139.4400], r:[[35.65100,139.44050],[35.65450,139.44550],[35.65600,139.44400],[35.66000,139.41400],[35.65450,139.41700]] },
        { n:'No.54', name:'大宮公園 桜はしご', c:[35.9150,139.6320], r:[[35.90620,139.62490],[35.91200,139.62800],[35.91850,139.63200],[35.92050,139.63350],[35.92400,139.63500],[35.91950,139.63250]] },
        { n:'No.55', name:'小金井公園〜野川 桜堤', c:[35.7080,139.5150], r:[[35.70000,139.52000],[35.71650,139.51050],[35.71550,139.51200],[35.69800,139.50500],[35.70150,139.50600]] }
      ]
    }
  ];


  var map, routeLayer, routeReqId = 0;
  var currentSeries = 0;
  var currentCourse = 0;

  function buildButtons() {
    var sc = document.getElementById('series-controls');
    var cc = document.getElementById('course-controls');
    sc.innerHTML = '';
    cc.innerHTML = '';

    SERIES.forEach(function (s, si) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'map-btn' + (si === currentSeries ? ' series-on' : '');
      b.textContent = s.name;
      b.onclick = function () { currentSeries = si; currentCourse = 0; buildButtons(); renderCourse(); };
      sc.appendChild(b);
    });

    SERIES[currentSeries].courses.forEach(function (c, ci) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'map-btn' + (ci === currentCourse ? ' on' : '');
      b.textContent = c.n + ' ' + c.name;
      b.onclick = function () { currentCourse = ci; buildButtons(); renderCourse(); };
      cc.appendChild(b);
    });
  }

  function haversine(a,b){
    var R=6371000, toRad=function(d){return d*Math.PI/180;};
    var dLat=toRad(b[0]-a[0]), dLon=toRad(b[1]-a[1]);
    var lat1=toRad(a[0]), lat2=toRad(b[0]);
    var h=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1)*Math.cos(lat2)*Math.sin(dLon/2)*Math.sin(dLon/2);
    return 2*R*Math.asin(Math.sqrt(h));
  }
  function straightLength(pts){
    var s=0; for(var i=1;i<pts.length;i++) s+= haversine(pts[i-1], pts[i]); return s;
  }
  function renderCourse() {
    if (!map) return;
    if (!routeLayer) routeLayer = L.layerGroup().addTo(map);
    routeLayer.clearLayers();

    var course = SERIES[currentSeries].courses[currentCourse];
    var color = SERIES[currentSeries].color;
    var pts = course.r;

    drawRoute(course, color, pts);

    pts.forEach(function (p, i) {
      var isStart = (i === 0);
      var isGoal = (i === pts.length - 1);
      var fill = isStart ? '#2563eb' : (isGoal ? '#e11d48' : '#64748b');
      var radius = (isStart || isGoal) ? 7 : 5;
      var kind = isStart ? '起点（Start）' : (isGoal ? 'ゴール（Goal）' : '経由点 ' + i);
      var m = L.circleMarker(p, { radius: radius, color: '#fff', weight: 2, fillColor: fill, fillOpacity: 1 });
      var popup = '<b>' + course.n + ' ' + course.name + '</b><br>' + kind;
      if(!isStart && !isGoal){
        m.bindTooltip(String(i), {permanent:false, direction:'top', offset:[0,-6]});
      }
      m.bindPopup(popup);
      m.addTo(routeLayer);
      if(!isStart && !isGoal){
        var lbl = L.divIcon({className:'', html:'<div style="background:'+color+';color:#fff;font-size:9px;font-weight:700;border-radius:50%;width:16px;height:16px;line-height:16px;text-align:center;border:1px solid #fff;box-shadow:0 1px 3px rgba(0,0,0,.3)">'+i+'</div>', iconSize:[16,16], iconAnchor:[8,8]});
        L.marker(p, {icon: lbl, interactive:false}).addTo(routeLayer);
      }
    });

    try{ map.fitBounds(L.latLngBounds(pts).pad(0.28)); }catch(e){}
    renderDetail(course);
  }

  function findCard(course) {
    var cards = document.querySelectorAll('.card');
    for (var i = 0; i < cards.length; i++) {
      var h = cards[i].querySelector('h3');
      if (h && h.textContent.indexOf(course.n + '｜') === 0) return cards[i];
    }
    return null;
  }

  function renderDetail(course) {
    var el = document.getElementById('map-detail');
    if (!el) return;
    var card = findCard(course);
    if (!card) {
      el.innerHTML = '<div class="map-detail-empty">このコースの詳細カードが見つかりませんでした。</div>';
      return;
    }
    var clone = card.cloneNode(true);
    el.innerHTML = '<div class="map-detail-label">選択中コースの旅程詳細</div>' + clone.innerHTML;
  }

  function drawRoute(course, color, pts) {
    var reqId = ++routeReqId;
    var straight = straightLength(pts);
    var fallbackDash = L.polyline(pts, { color: '#fff', weight: 7, opacity: 0.35, dashArray: '4,10' });
    fallbackDash.addTo(routeLayer);
    var fallback = L.polyline(pts, { color: color, weight: 4.5, opacity: 0.95 });
    fallback.addTo(routeLayer);
    fallbackDash.bringToBack();

    var coordStr = pts.map(function (p) { return p[1].toFixed(6) + ',' + p[0].toFixed(6); }).join(';');
    var url = 'https://router.project-osrm.org/route/v1/foot/' + coordStr + '?overview=full&geometries=geojson&steps=false';

    fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (data) {
        if (reqId !== routeReqId) return;
        if (!data || data.code !== 'Ok' || !data.routes || !data.routes.length) return;
        var route = data.routes[0];
        var coords = route.geometry.coordinates;
        var latlngs = coords.map(function (c) { return [c[1], c[0]]; });
        var routedDist = route.distance || 0;
        var ratio = straight>0 ? routedDist/straight : 1;
        var over = routedDist - straight;
        var suspicious = (ratio > 1.7 && routedDist>2000) || (over > 2500 && ratio>1.35);
        if(suspicious){
          var hint = L.polyline(latlngs, { color: color, weight: 3, opacity: 0.22, dashArray: '6,8' });
          hint.addTo(routeLayer);
          try{ map.fitBounds(fallback.getBounds().pad(0.22)); }catch(e){}
          return;
        }
        try{ routeLayer.removeLayer(fallback); routeLayer.removeLayer(fallbackDash); }catch(e){}
        var outline = L.polyline(latlngs, { color: '#fff', weight: 8, opacity: 0.25 });
        outline.addTo(routeLayer);
        L.polyline(latlngs, { color: color, weight: 5, opacity: 0.92 }).addTo(routeLayer);
        try{ map.fitBounds(L.latLngBounds(latlngs).pad(0.20)); }catch(e){}
      })
      .catch(function () {
        try{ map.fitBounds(fallback.getBounds().pad(0.22)); }catch(e){}
      });
  }

  function escapeHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function buildNav() {
    var nav = document.getElementById('map-nav');
    if (!nav) return;

    var chapLinks = '';
    var hs = document.querySelectorAll('h2[id^="sec-"]');
    for (var i = 0; i < hs.length; i++) {
      chapLinks += '<a class="map-nav-link" href="#' + hs[i].id + '">' + escapeHtml(hs[i].textContent) + '</a>';
    }

    var courseLinks = '';
    SERIES.forEach(function (s) {
      courseLinks += '<div class="map-nav-group">' + escapeHtml(s.name) + '</div>';
      s.courses.forEach(function (c) {
        var num = c.n.replace('No.', '');
        courseLinks += '<a class="map-nav-link" href="#course-' + num + '">' + escapeHtml(c.n + ' ' + c.name) + '</a>';
      });
    });

    nav.innerHTML =
      '<a class="map-nav-top" href="#top">↑ 本文トップへ</a>' +
      '<details class="map-nav-details" open>' +
        '<summary>本文の各章へジャンプ（第1〜18章）</summary>' +
        '<div class="map-nav-links">' + chapLinks + '</div>' +
      '</details>' +
      '<details class="map-nav-details">' +
        '<summary>各コースカードへジャンプ（No.1〜45）</summary>' +
        '<div class="map-nav-links">' + courseLinks + '</div>' +
      '</details>';
  }

  function init() {
    map = L.map('map', { zoomControl: true });
    map.setView([35.68, 139.75], 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    buildButtons();
    renderCourse();
    buildNav();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
</body>
</html>
