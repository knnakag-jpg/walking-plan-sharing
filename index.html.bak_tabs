<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026年 秋季 4名歩行会 統合企画書（第7版・全55コース・インタラクティブマップ）</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
  :root{
    --ink:#1c2430;
    --sub:#5b6875;
    --line:#d8dee6;
    --bg:#f6f8fa;
    --accent:#1f5f8b;
    --accent2:#0e7c6b;
    --warn:#b3541e;
    --ng:#a02c2c;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;padding:0;
    font-family:"Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;
    color:var(--ink);background:var(--bg);line-height:1.8;
    font-size:15px;
  }
  .wrap{max-width:1080px;margin:0 auto;padding:32px 20px 80px;background:#fff;}
  header.cover{
    border-bottom:4px solid var(--accent);
    padding-bottom:20px;margin-bottom:32px;
  }
  header.cover .eyebrow{color:var(--accent);font-size:13px;letter-spacing:.18em;margin:0 0 6px;}
  header.cover h1{font-size:26px;margin:0 0 10px;line-height:1.5;}
  header.cover .meta{color:var(--sub);font-size:13px;}
  h2{
    font-size:20px;margin:48px 0 14px;padding:8px 0 8px 12px;
    border-left:6px solid var(--accent);background:linear-gradient(90deg,#eef4f9,#fff);
  }
  h3{font-size:17px;margin:28px 0 10px;padding-bottom:4px;border-bottom:1px dashed var(--line);}
  h4{font-size:15px;margin:18px 0 6px;color:var(--accent);}
  p{margin:8px 0;}
  table{
    width:100%;border-collapse:collapse;margin:14px 0 20px;font-size:13.5px;background:#fff;
  }
  th,td{border:1px solid var(--line);padding:7px 9px;vertical-align:top;text-align:left;}
  th{background:#eef2f6;font-weight:600;white-space:nowrap;}
  td.c,th.c{text-align:center;white-space:nowrap;}
  .note{
    background:#fffaf0;border:1px solid #e8d8b0;padding:12px 14px;margin:16px 0;font-size:13.5px;
  }
  .caution{
    background:#fdf1ee;border:1px solid #eec9bd;padding:12px 14px;margin:16px 0;font-size:13.5px;
  }
  .info{
    background:#eef6f5;border:1px solid #bcdcd6;padding:12px 14px;margin:16px 0;font-size:13.5px;
  }
  .v3note{
    background:#faf0fc;border:1px solid #e3b8ec;padding:12px 14px;margin:16px 0;font-size:13.5px;
  }
  .v3note b{color:#c026d3;}
  .grade{
    display:inline-block;min-width:22px;text-align:center;border-radius:4px;
    color:#fff;font-weight:700;padding:1px 7px;font-size:12.5px;
  }
  .gA{background:#0e7c6b;} .gB{background:#2f7fb8;} .gC{background:#b28c1e;}
  .gD{background:#b3541e;} .gF{background:#a02c2c;}
  .tag{
    display:inline-block;border:1px solid var(--line);background:#f2f5f8;color:var(--sub);
    border-radius:12px;padding:1px 9px;font-size:12px;margin:2px 4px 2px 0;
  }
  .card{
    border:1px solid var(--line);border-radius:6px;padding:18px 20px;margin:22px 0;background:#fff;
    box-shadow:0 1px 2px rgba(0,0,0,.04);
  }
  .card h3{margin-top:0;border-bottom:2px solid var(--accent);}
  .kv{display:flex;flex-wrap:wrap;gap:0 18px;font-size:13px;color:var(--sub);margin-bottom:10px;}
  .kv span b{color:var(--ink);}
  ul,ol{margin:8px 0 8px 1.4em;padding:0;}
  li{margin:4px 0;}
  .route{
    background:#f4f7fa;border-left:4px solid var(--accent2);padding:10px 14px;font-size:13px;margin:12px 0;
  }
  .route code{background:none;font-family:inherit;}
  footer{margin-top:60px;padding-top:16px;border-top:1px solid var(--line);color:var(--sub);font-size:12.5px;}
  .toc{background:#f4f7fa;border:1px solid var(--line);padding:16px 22px;font-size:13.5px;}
  .toc ol{margin:0 0 0 1.2em;}
  .small{font-size:12.5px;color:var(--sub);}
  .rank{font-weight:700;color:var(--accent);}
  @media print{ body{background:#fff;} .wrap{max-width:none;} }

  /* ===== 統合インタラクティブマップ用 ===== */
  #map{height:540px;width:100%;border:1px solid var(--line);border-radius:6px;margin:14px 0;z-index:1;}
  .map-wrap{max-width:1080px;margin:0 auto;}
  .map-series-controls,.map-course-controls{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0;}
  .map-btn{padding:7px 13px;border-radius:18px;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:12.5px;font-weight:600;cursor:pointer;transition:all .15s;}
  .map-btn:hover{border-color:var(--accent);}
  .map-btn.on{background:var(--accent);color:#fff;border-color:var(--accent);}
  .map-btn.series-on{background:var(--accent2);color:#fff;border-color:var(--accent2);}
  .map-legend{display:flex;flex-wrap:wrap;gap:14px;margin:8px 0 4px;font-size:12px;color:var(--sub);}
  .map-legend .dot{width:11px;height:11px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle;}
  .map-note{font-size:12px;color:var(--sub);margin-top:6px;}
  .map-detail{margin:16px 0 0;padding:16px 18px;border:1px solid var(--line);border-radius:6px;background:#fbfcfe;}
  .map-detail-label{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.05em;color:#fff;background:var(--accent);border-radius:4px;padding:3px 10px;margin-bottom:12px;}
  .map-detail-empty{color:var(--sub);font-size:13px;}
  /* ===== マップCTA・ジャンプナビ ===== */
  .map-cta{margin:0 0 20px;}
  .map-cta a{display:inline-block;background:var(--accent);color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:11px 18px;border-radius:6px;box-shadow:0 1px 3px rgba(0,0,0,.15);}
  .map-cta a:hover{background:var(--accent2);}
  .map-nav{margin:16px 0;padding:12px 14px;border:1px solid var(--line);border-radius:6px;background:#f4f7fa;font-size:12.5px;}
  .map-nav-top{display:inline-block;margin-bottom:8px;color:var(--accent);font-weight:700;text-decoration:none;}
  .map-nav-details{margin:6px 0;}
  .map-nav-details summary{cursor:pointer;font-weight:700;color:var(--accent);font-size:13px;}
  .map-nav-links{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;}
  .map-nav-group{flex-basis:100%;margin-top:8px;font-weight:700;color:var(--sub);font-size:12px;border-top:1px dashed var(--line);padding-top:6px;}
  .map-nav-link{display:inline-block;padding:3px 9px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink);text-decoration:none;font-size:12px;}
  .map-nav-link:hover{border-color:var(--accent);color:var(--accent);}
  @media (max-width:680px){
    body{font-size:14px;}
    .wrap{padding:20px 12px 64px;}
    header.cover h1{font-size:20px;}
    h2{font-size:18px;}
    #map{height:400px;}
    table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .map-cta a{display:block;text-align:center;box-sizing:border-box;}
  }
</style>
</head>
